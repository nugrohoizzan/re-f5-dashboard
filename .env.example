# Postgres connection strings from Neon (https://neon.tech)
# DATABASE_URL is used by the app at runtime (pooled connection, recommended: use the "pooled" connection string Neon gives you)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/f5ops?sslmode=require"
# DIRECT_URL is used only for migrations (Neon's "direct"/unpooled connection string)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/f5ops?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob storage — used for MOP file uploads (PDF/DOCX).
# In your Vercel project: Storage tab -> Create Database -> Blob.
# This env var is auto-injected on Vercel deploys; for local dev, copy the
# token shown in the Blob store's ".env.local" tab into this value.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"
